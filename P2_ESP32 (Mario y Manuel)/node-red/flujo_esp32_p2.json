  {
    "id": "esp_fn_url",
    "type": "function",
    "z": "tab_esp32",
    "name": "URL de Open Weather Map",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 1260,
    "wires": [
      [
        "esp_http_owm"
      ]
    ],
    "func": "// Tiempo actual de Vigo. La API key es la variable de entorno OPENWEATHER_API_KEY.\nconst key = env.get(\"OPENWEATHER_API_KEY\");\nif (!key || key === \"PON_AQUI_TU_API_KEY\") {\n    node.status({ fill: \"red\", shape: \"ring\", text: \"falta OPENWEATHER_API_KEY (Settings, Environment)\" });\n    return null;\n}\nmsg.url = `https://api.openweathermap.org/data/2.5/weather?q=Vigo,ES&units=metric&lang=es&appid=${encodeURIComponent(key)}`;\nnode.status({});\nreturn msg;"
  },
  {
    "id": "esp_http_owm",
    "type": "http request",
    "z": "tab_esp32",
    "name": "Open Weather Map: Vigo",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 570,
    "y": 1260,
    "wires": [
      [
        "esp_fn_tiempo"
      ]
    ]
  },
  {
    "id": "esp_fn_tiempo",
    "type": "function",
    "z": "tab_esp32",
    "name": "Tiempo a aviso de suelo mojado",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 810,
    "y": 1260,
    "wires": [
      [
        "esp_mqtt_out"
      ]
    ],
    "func": "// Misma regla que en la P1. Solo se publica si cambia; la parada lo dice una vez por usuario.\nif (msg.statusCode !== 200 || !msg.payload || typeof msg.payload !== \"object\") {\n    node.status({ fill: \"red\", shape: \"ring\", text: `error ${msg.statusCode}` });\n    return null;\n}\nconst datos = msg.payload;\nconst codigo = (datos.weather && datos.weather[0] && datos.weather[0].id) || 0;\nconst grupo = Math.floor(codigo / 100);\nconst lluviaMm = (datos.rain && (datos.rain[\"1h\"] || datos.rain[\"3h\"])) || 0;\nconst temp = datos.main && datos.main.temp;\nconst detalle = (datos.weather && datos.weather[0] && datos.weather[0].description) || codigo;\n\nlet aviso = null;\nif (grupo === 6) aviso = \"Atención: está nevando, el suelo puede estar resbaladizo.\";\nelse if (grupo === 2) aviso = \"Atención: hay tormenta, el suelo está mojado. Tenga cuidado al subir al autobús.\";\nelse if (grupo === 5 || grupo === 3) aviso = \"Atención: está lloviendo, el suelo puede estar resbaladizo. Tenga cuidado al subir al autobús.\";\nelse if (lluviaMm > 0) aviso = \"Atención: ha llovido recientemente, el suelo puede estar mojado.\";\nif (aviso && typeof temp === \"number\" && temp <= 0) aviso += \" Puede haber hielo.\";\n\nnode.status(aviso ? { fill: \"blue\", shape: \"dot\", text: `suelo mojado (${detalle})` }\n                  : { fill: \"green\", shape: \"dot\", text: `suelo seco (${detalle})` });\nif (context.get(\"ultimo\") === aviso) return null;\ncontext.set(\"ultimo\", aviso);\nconst P = env.get(\"TOPIC_PREFIX\");\nreturn { topic: `${P}/parada/${env.get(\"PARADA_ID\")}/tiempo`, payload: { aviso: aviso }, qos: 1, retain: true };"
  },
