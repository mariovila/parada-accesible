  {
    "id": "esp_fn_estado",
    "type": "function",
    "z": "tab_esp32",
    "name": "Estado de los ESP32",
    "outputs": 7,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 790,
    "y": 200,
    "outputLabels": [
      "parada: conexión",
      "parada: ultrasonidos",
      "parada: usuario y solicitud",
      "parada: altavoz",
      "autobús: conexión",
      "autobús: LCD",
      "autobús: zumbador y rampa"
    ],
    "func": "// Reparte lo que publican los ESP32 a los widgets del dashboard.\n// Salidas: 1-4 parada, 5-7 autobús (ver etiquetas de las salidas).\nconst P = env.get(\"TOPIC_PREFIX\");\nconst partes = msg.topic.slice(P.length + 1).split(\"/\");   // [parada|autobus, id, tema]\nconst [clase, , tema] = partes;\nconst p = msg.payload;\nconst out = new Array(7).fill(null);\nconst conexion = v => v === \"online\" ? \"conectado\" : \"DESCONECTADO\";\n\nif (clase === \"parada\") {\n    if (tema === \"conexion\") out[0] = { payload: conexion(String(p)) };\n    else if (tema === \"telemetria\" && p && typeof p === \"object\") {\n        out[1] = { payload: `${p.distancia_cm} cm${p.vehiculo ? \" (vehículo detenido)\" : \"\"}` };\n        out[2] = { payload: `${p.usuario ? \"usuario \" + p.usuario : \"sin usuario\"}${p.solicitud ? \" | solicitud \" + p.solicitud : \"\"}` };\n    } else if (tema === \"altavoz\" && p && p.texto) out[3] = { payload: p.texto };\n} else if (clase === \"autobus\") {\n    if (tema === \"conexion\") out[4] = { payload: conexion(String(p)) };\n    else if (tema === \"telemetria\" && p && typeof p === \"object\") {\n        const l = Array.isArray(p.lcd) ? p.lcd : [\"\", \"\"];\n        out[5] = { payload: `[${(l[0] || \"\").padEnd(8)}][${(l[1] || \"\").padEnd(8)}]` };\n        out[6] = { payload: `zumbador ${p.zumbador ? \"SONANDO\" : \"apagado\"} | rampa ${p.rampa_grados} grados` };\n    }\n}\nreturn out;\n",
    "wires": [
      [
        "esp_ui_par_conexion"
      ],
      [
        "esp_ui_par_us"
      ],
      [
        "esp_ui_par_usuario"
      ],
      [
        "esp_ui_par_altavoz"
      ],
      [
        "esp_ui_bus_conexion"
      ],
      [
        "esp_ui_bus_lcd"
      ],
      [
        "esp_ui_bus_act"
      ]
    ]
  },
