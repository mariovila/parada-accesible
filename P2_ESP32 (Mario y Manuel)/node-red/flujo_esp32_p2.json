  {
    "id": "esp_fn_control",
    "type": "function",
    "z": "tab_esp32",
    "name": "Control de actuadores",
    "func": "// Ejercicio 4: el dashboard controla los actuadores de las placas.\n// msg.topic dice qué actuador y msg.payload el valor.\nconst P = env.get(\"TOPIC_PREFIX\");\nif (msg.topic === \"decir\") {\n    const texto = String(msg.payload || \"\").trim();\n    if (!texto) return null;\n    return { topic: `${P}/parada/${env.get(\"PARADA_ID\")}/control`,\n             payload: { accion: \"decir\", texto } };\n}\nnode.status({ text: `${msg.topic}: ${msg.payload ? \"sí\" : \"no\"}` });\nreturn { topic: `${P}/autobus/${env.get(\"BUS_ID\")}/control`,\n         payload: { accion: msg.topic, valor: msg.payload === true } };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
