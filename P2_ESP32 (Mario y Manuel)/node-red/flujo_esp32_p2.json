  {
    "id": "esp_fn_conectar",
    "type": "function",
    "z": "tab_esp32",
    "name": "Conectar y suscribir",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 320,
    "y": 100,
    "wires": [
      [
        "esp_mqtt_in"
      ]
    ],
    "func": "// Conecta con el broker y se suscribe a lo que publican los dos ESP32.\nconst P = env.get(\"TOPIC_PREFIX\");\nconst PA = `${P}/parada/${env.get(\"PARADA_ID\")}/`;\nconst BU = `${P}/autobus/${env.get(\"BUS_ID\")}/`;\nconst temas = [\n    PA + \"telemetria\", PA + \"conexion\", PA + \"deteccion\", PA + \"solicitud\", PA + \"altavoz\",\n    BU + \"telemetria\", BU + \"conexion\", BU + \"evento\"\n];\nnode.send({ action: \"connect\", broker: {\n    broker: env.get(\"MQTT_BROKER\"), port: Number(env.get(\"MQTT_PORT\")),\n    clientid: \"\", cleansession: true, force: true\n} });\nnode.send({ action: \"subscribe\", topic: temas.map(t => ({ topic: t, qos: 1 })) });\nnode.status({ fill: \"blue\", shape: \"ring\", text: `${temas.length} suscripciones` });\nreturn null;"
  },
